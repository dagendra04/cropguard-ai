PORT=3000

# -----------------------------------------------
# SMS ALERTS - OPTIONAL
# Bina is key ke bhi app chalega (demo mode)
# Get from: https://console.twilio.com
# -----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------
# DISEASE DETECTION - OPTIONAL
# Bina key ke mock diseases dikhayega
# Get from: https://crop.health -> API Keys
# -----------------------------------------------
KINDWISE_API_KEY=

# -----------------------------------------------
# AI CHATBOT - OPTIONAL
# Bina key ke pre-written replies milenge
# Get from: https://platform.openai.com/api-keys
# -----------------------------------------------
OPENAI_API_KEY=

# VOICE ASSISTANT - OPTIONAL
# Get from: https://elevenlabs.io -> Profile -> API
# -----------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=M
ELEVENLABS_AGENT_ID=
# -----------------------------------------------
# OFFICER DASHBOARD AUTH
# Production mein is secret ko zaroor change karein!
# -----------------------------------------------
OFFICER_SECRET=officer123

# -----------------------------------------------
# TELEGRAM ALERTS - OPTIONAL
# Create a bot using BotFather on Telegram and get the token.
# -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

